---
import { PROVISIONS, PROVISION_ORDER, loadoutCost, provisionIcon, stacks } from '../data/provisions';
import type { ProvisionId } from '../data/types';

interface Props {
  loadout: Partial<Record<ProvisionId, number>>;
  label: string;
}
const { loadout, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slots = PROVISION_ORDER.flatMap((id) => stacks(loadout[id] ?? 0, PROVISIONS[id].stack).map((q) => ({ id, q })));
---

<ul class="inventory" aria-label={label}>
  {
    slots.map(({ id, q }) => (
      <li class="slot" title={PROVISIONS[id].label}>
        <img src={`${base}icons/${provisionIcon(id, q)}`} alt="" width="40" height="80" />
        <span class="qty" aria-hidden="true">
          {q > 1 ? q : ''}
        </span>
        <span class="sr-only">
          {q} {PROVISIONS[id].label}
        </span>
      </li>
    ))
  }
</ul>
<p class="total">
  <span>Total cost</span>
  <img src={`${base}icons/coin.png`} alt="" width="16" height="16" />
  <strong>{loadoutCost(loadout).toLocaleString('en-US')}</strong>
  {loadout.theBlood ? <small class="total-note">+ The Blood (not sold)</small> : null}
</p>
