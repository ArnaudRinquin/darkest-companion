---
import App from '../components/App.astro';
import Base from '../layouts/Base.astro';
import { REGIONS } from '../data/regions';
import type { Region } from '../data/types';
import { appLd, regionCurioNames } from '../lib/seo';

export function getStaticPaths() {
  return REGIONS.map((region) => ({ params: { region: region.id }, props: { region } }));
}

const { region } = Astro.props as { region: Region };
const names = regionCurioNames(region);
const title = `${region.label} Curios & Provisions | Darkest Dungeon | Darkest Companion`;
const description = `Darkest Dungeon ${region.label} curios: what to use on ${names.slice(0, 4).join(', ')} and more, with outcome odds and recommended ${region.label} provisions.`;
const url = new URL(`${import.meta.env.BASE_URL}${region.id}/`, Astro.site).href;
---

<Base title={title} description={description} path={`${region.id}/`} jsonLd={[appLd(url, description)]}>
  <App pinnedRegion={region.id} />
</Base>
