---
import App from '../components/App.astro';
import Base from '../layouts/Base.astro';
import { appLd } from '../lib/seo';

const title = 'Darkest Dungeon Curios & Provisions Guide | Darkest Companion';
const description =
  'What to use on every Darkest Dungeon curio, with outcome odds: Ruins, Warrens, Weald, Cove, plus the Courtyard (Crimson Court) and Farmstead (Color of Madness). Recommended provisions by expedition length.';
const url = new URL(import.meta.env.BASE_URL, Astro.site).href;
---

<Base title={title} description={description} path="" jsonLd={[appLd(url, description)]}>
  <App />
</Base>
